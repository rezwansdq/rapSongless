{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rap-songless",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  // node:crypto is used for the seeded daily shuffle (see src/song-daily.js)
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only /api/* needs the Worker; everything else is served straight from the asset store.
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true }
  // Custom domain (songdle.win): add in the dashboard under Workers > rap-songless > Settings > Domains,
  // or uncomment:
  // "routes": [{ "pattern": "songdle.win", "custom_domain": true }]
}
